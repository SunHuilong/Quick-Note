    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.3.8"
  }
}
